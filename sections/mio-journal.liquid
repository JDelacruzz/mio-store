{%- liquid
  assign journal_blog = section.settings.blog
  assign has_articles = false
  if journal_blog != blank and journal_blog.articles_count > 0
    assign has_articles = true
  endif

  assign show_section = has_articles
  if request.design_mode
    assign show_section = true
  endif

  assign journal_link = section.settings.link
  if journal_link == blank and journal_blog != blank
    assign journal_link = '/blogs/' | append: journal_blog.handle
  endif
  if journal_link == blank
    assign journal_link = routes.all_products_collection_url
  endif
-%}

{%- if show_section -%}
  <div class="section-background color-{{ section.settings.color_scheme }}"></div>

  <section
    class="mio-journal section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }} spacing-style"
    style="{% render 'spacing-style', settings: section.settings %}"
  >
    <div class="mio-journal__header">
      <div class="mio-journal__header-copy">
        {%- if section.settings.eyebrow != blank -%}
          <p class="mio-journal__eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="mio-journal__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
      </div>
      {%- if section.settings.link_label != blank and has_articles -%}
        <a class="mio-journal__header-link" href="{{ journal_link }}">
          {{ section.settings.link_label }}
          <span aria-hidden="true">{{- 'icon-arrow.svg' | inline_asset_content -}}</span>
        </a>
      {%- endif -%}
    </div>

    <div class="mio-journal__grid">
      {%- if has_articles -%}
        {%- for article in journal_blog.articles limit: 3 -%}
          {%- liquid
            assign article_alt = article.image.alt | default: article.title
            assign article_excerpt = article.excerpt_or_content | strip_html | strip_newlines | truncate: 128
          -%}
          <article
            class="mio-journal__card"
            data-mio-reveal="fade"
            style="--mio-delay: {{ forloop.index0 | times: 70 }}ms"
          >
            <a
              class="mio-journal__media"
              href="{{ article.url }}"
              tabindex="-1"
              aria-hidden="true"
            >
              {%- if article.image != blank -%}
                {{
                  article.image
                  | image_url: width: 1200
                  | image_tag:
                    widths: '360, 540, 720, 960, 1200',
                    sizes: '(min-width: 990px) 31vw, 92vw',
                    class: 'mio-journal__image',
                    loading: 'lazy',
                    alt: article_alt
                }}
              {%- else -%}
                <div class="mio-journal__placeholder">
                  {{ 'lifestyle-1' | placeholder_svg_tag: 'mio-journal__placeholder-svg' }}
                </div>
              {%- endif -%}
            </a>

            <div class="mio-journal__body">
              <p class="mio-journal__meta">
                <time datetime="{{ article.published_at | date: '%Y-%m-%d' }}">
                  {{- article.published_at | date: '%d.%m.%Y' -}}
                </time>
                {%- if article.tags.size > 0 %} · {{ article.tags.first }}{% endif -%}
              </p>
              <h3 class="mio-journal__title">
                <a href="{{ article.url }}">{{ article.title }}</a>
              </h3>
              {%- if article_excerpt != blank -%}
                <p class="mio-journal__excerpt">{{ article_excerpt }}</p>
              {%- endif -%}
              <a class="mio-journal__more" href="{{ article.url }}">
                Leer más
                <span aria-hidden="true">{{- 'icon-arrow.svg' | inline_asset_content -}}</span>
              </a>
            </div>
          </article>
        {%- endfor -%}
      {%- else -%}
        {%- assign placeholder_titles = 'Tu primera historia,Una guía útil,Detrás de Mio Store' | split: ',' -%}
        {%- for i in (1..3) -%}
          <article
            class="mio-journal__card"
            data-mio-reveal="fade"
            style="--mio-delay: {{ forloop.index0 | times: 70 }}ms"
          >
            <div class="mio-journal__media">
              <div class="mio-journal__placeholder">
                {{ 'lifestyle-2' | placeholder_svg_tag: 'mio-journal__placeholder-svg' }}
              </div>
            </div>
            <div class="mio-journal__body">
              <p class="mio-journal__meta">Próximamente</p>
              <h3 class="mio-journal__title">{{ placeholder_titles[forloop.index0] }}</h3>
              <p class="mio-journal__excerpt">
                Selecciona un blog y publica artículos para mostrar el diario en tu tienda.
              </p>
            </div>
          </article>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </section>
{%- endif -%}

{% stylesheet %}
  .mio-journal__header {
    display: flex;
    flex-direction: column;
    gap: 18px;
    margin-bottom: 28px;
  }

  .mio-journal__eyebrow {
    margin: 0 0 8px;
    color: rgb(var(--color-foreground-rgb) / 0.6);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .mio-journal__heading {
    margin: 0;
    font-family: var(--font-heading--family);
    font-weight: var(--font-heading--weight, 700);
    font-size: clamp(2rem, 3.8vw, 3.5rem);
    line-height: 1;
    letter-spacing: -0.04em;
  }

  .mio-journal__header-link {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    align-self: flex-start;
    padding-bottom: 5px;
    border-bottom: 1px solid currentColor;
    color: var(--color-foreground);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .mio-journal__header-link svg {
    width: 14px;
    height: 14px;
    transition: transform 180ms var(--mio-ease-out);
  }

  .mio-journal__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 28px;
  }

  .mio-journal__card {
    min-width: 0;
  }

  .mio-journal__media {
    display: block;
    overflow: hidden;
    border-radius: 4px;
    background: rgb(var(--color-foreground-rgb) / 0.06);
  }

  .mio-journal__image,
  .mio-journal__placeholder-svg {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    transition: transform 700ms var(--mio-ease-out);
  }

  .mio-journal__placeholder {
    display: grid;
    place-items: center;
    aspect-ratio: 4 / 3;
    background: rgb(var(--color-foreground-rgb) / 0.05);
  }

  .mio-journal__body {
    padding-top: 16px;
  }

  .mio-journal__meta {
    margin: 0;
    color: rgb(var(--color-foreground-rgb) / 0.52);
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .mio-journal__title {
    margin: 8px 0 10px;
    font-family: var(--font-heading--family);
    font-size: clamp(1.25rem, 2vw, 1.5rem);
    font-weight: var(--font-heading--weight, 700);
    line-height: 1.16;
    letter-spacing: -0.025em;
  }

  .mio-journal__title a {
    color: var(--color-foreground);
    text-decoration: none;
  }

  .mio-journal__excerpt {
    margin: 0 0 14px;
    color: rgb(var(--color-foreground-rgb) / 0.68);
    font-size: 0.9375rem;
    line-height: 1.6;
  }

  .mio-journal__more {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding-bottom: 4px;
    border-bottom: 1px solid currentColor;
    color: var(--color-foreground);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .mio-journal__more svg {
    width: 13px;
    height: 13px;
    transition: transform 180ms var(--mio-ease-out);
  }

  .mio-journal.section--full-width .mio-journal__header,
  .mio-journal.section--full-width .mio-journal__grid {
    padding-inline: var(--page-margin);
  }

  @media (hover: hover) and (pointer: fine) {
    .mio-journal__header-link:hover svg,
    .mio-journal__more:hover svg {
      transform: translateX(4px);
    }

    .mio-journal__card:hover .mio-journal__image {
      transform: scale(1.03);
    }
  }

  @media screen and (min-width: 750px) {
    .mio-journal__header {
      flex-direction: row;
      align-items: flex-end;
      justify-content: space-between;
      gap: 32px;
    }

    .mio-journal__header-link {
      align-self: flex-end;
      flex-shrink: 0;
    }

    .mio-journal__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 24px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Mio · Diario",
  "class": "mio-journal-wrapper",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "blog",
      "id": "blog",
      "label": "Blog",
      "info": "La sección se oculta hasta que el blog tenga artículos."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Antetítulo",
      "default": "El diario de Mio"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Historias para vivir mejor"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Texto del enlace",
      "default": "Ver el diario"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Enlace del diario",
      "info": "Si se deja vacío, se usa el blog seleccionado."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Esquema de color",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Ancho",
      "options": [
        { "value": "page-width", "label": "Página" },
        { "value": "full-width", "label": "Completo" }
      ],
      "default": "page-width"
    },
    {
      "type": "header",
      "content": "Espaciado"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Arriba",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Abajo",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 56
    }
  ],
  "presets": [
    {
      "name": "Mio · Diario",
      "category": "Mio Store"
    }
  ]
}
{% endschema %}
