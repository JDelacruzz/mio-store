{%- if section.blocks.size > 0 -%}
  <div class="section-background color-{{ section.settings.color_scheme }}"></div>

  <section
    class="mio-cod section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }} spacing-style"
    style="{% render 'spacing-style', settings: section.settings %}"
  >
    <div class="mio-cod__inner">
      <div class="mio-cod__content" data-mio-reveal>
        {%- if section.settings.eyebrow != blank -%}
          <p class="mio-cod__eyebrow">
            {% render 'mio-icons', icon: 'cash', size: 14 %}
            {{ section.settings.eyebrow }}
          </p>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <h2 class="mio-cod__title">{{ section.settings.heading }}</h2>
        {%- endif -%}

        {%- if section.settings.text != blank -%}
          <div class="mio-cod__text rte">{{ section.settings.text }}</div>
        {%- endif -%}

        {%- if section.settings.button_label != blank -%}
          <a class="button mio-cod__button" href="{{ section.settings.button_link }}">
            {{ section.settings.button_label }}
          </a>
        {%- endif -%}
      </div>

      <ol class="mio-cod__steps" role="list" data-mio-stagger="90">
        {%- for block in section.blocks -%}
          <li class="mio-cod__step" data-mio-reveal {{ block.shopify_attributes }}>
            <span class="mio-cod__step-number" aria-hidden="true">{{ forloop.index }}</span>
            <div class="mio-cod__step-copy">
              <strong>{{ block.settings.title }}</strong>
              <p>{{ block.settings.text }}</p>
            </div>
            <span class="mio-cod__step-icon" aria-hidden="true">
              {% render 'mio-icons', icon: block.settings.icon, size: 20 %}
            </span>
          </li>
        {%- endfor -%}
      </ol>
    </div>

    {%- if section.settings.note != blank -%}
      <p class="mio-cod__note">{{ section.settings.note }}</p>
    {%- endif -%}
  </section>
{%- endif -%}

{% stylesheet %}
  .mio-cod__inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: 28px;
    align-items: start;
  }

  .mio-cod__content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 14px;
  }

  .mio-cod__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin: 0;
    padding: 6px 11px;
    border-radius: 100px;
    background: rgb(255 255 255 / 0.45);
    border: 1px solid rgb(16 16 20 / 0.12);
    color: var(--mio-ink);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .mio-cod__title {
    margin: 0;
    font-size: clamp(1.75rem, 4.8vw, 3rem);
    line-height: 1.02;
    letter-spacing: -0.04em;
    text-wrap: balance;
  }

  .mio-cod__text {
    max-width: 46ch;
    font-size: 0.9375rem;
    line-height: 1.55;
    color: rgb(var(--color-foreground-rgb) / 0.68);
  }

  .mio-cod__text p {
    margin: 0;
  }

  .mio-cod__button {
    margin-block-start: 4px;
    min-height: 50px;
  }

  .mio-cod__steps {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .mio-cod__step {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px 16px;
    border: 1px solid rgb(var(--color-foreground-rgb) / 0.1);
    border-radius: 16px;
    background: rgb(var(--color-foreground-rgb) / 0.02);
  }

  .mio-cod__step-number {
    display: grid;
    place-items: center;
    flex: 0 0 auto;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: var(--mio-ink);
    color: #fff;
    font-size: 0.75rem;
    font-weight: 700;
  }

  .mio-cod__step-copy {
    min-width: 0;
  }

  .mio-cod__step-copy strong {
    display: block;
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1.25;
  }

  .mio-cod__step-copy p {
    margin: 2px 0 0;
    font-size: 0.75rem;
    line-height: 1.35;
    color: rgb(var(--color-foreground-rgb) / 0.6);
  }

  .mio-cod__step-icon {
    display: inline-flex;
    margin-inline-start: auto;
    color: rgb(var(--color-foreground-rgb) / 0.28);
  }

  .mio-cod__note {
    margin: 18px 0 0;
    font-size: 0.6875rem;
    text-align: center;
    color: rgb(var(--color-foreground-rgb) / 0.5);
  }

  @media screen and (min-width: 750px) {
    .mio-cod__inner {
      grid-template-columns: 1fr 1fr;
      gap: 40px;
      align-items: center;
    }
  }

  @media screen and (min-width: 990px) {
    .mio-cod__inner {
      grid-template-columns: 0.95fr 1.05fr;
      gap: 64px;
    }

    .mio-cod__step {
      padding: 16px 18px;
    }

    .mio-cod__step-copy strong {
      font-size: 0.9375rem;
    }

    .mio-cod__step-copy p {
      font-size: 0.8125rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Mio · Contra entrega",
  "class": "mio-cod-wrapper",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Antetítulo",
      "default": "Cero riesgo"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Paga solo cuando lo tengas en tus manos"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Texto",
      "default": "<p>Sin tarjetas, sin adelantos. Pides hoy y pagas contra entrega en tu casa u oficina.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Botón",
      "default": "Comprar contra entrega"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Enlace del botón"
    },
    {
      "type": "text",
      "id": "note",
      "label": "Nota",
      "default": "Disponible en las principales ciudades de Colombia. Aplican condiciones."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Esquema de color",
      "default": "scheme-2"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Ancho",
      "options": [
        {
          "value": "page-width",
          "label": "Página"
        },
        {
          "value": "full-width",
          "label": "Completo"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "header",
      "content": "Espaciado"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Arriba",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Abajo",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 56
    }
  ],
  "blocks": [
    {
      "type": "mio_step",
      "name": "Paso",
      "limit": 4,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Título",
          "default": "Elige tu producto"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Descripción",
          "default": "Agrégalo al carrito y confirma tu dirección."
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Icono",
          "options": [
            {
              "value": "package",
              "label": "Producto"
            },
            {
              "value": "truck",
              "label": "Entrega"
            },
            {
              "value": "cash",
              "label": "Pago"
            },
            {
              "value": "whatsapp",
              "label": "Confirmación"
            }
          ],
          "default": "package"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Mio · Contra entrega",
      "category": "Mio Store",
      "blocks": {
        "s1": {
          "type": "mio_step",
          "settings": {
            "title": "Elige tu producto",
            "text": "Agrégalo al carrito y confirma tu dirección.",
            "icon": "package"
          }
        },
        "s2": {
          "type": "mio_step",
          "settings": {
            "title": "Te contactamos para confirmar",
            "text": "Te escribimos por WhatsApp el mismo día.",
            "icon": "whatsapp"
          }
        },
        "s3": {
          "type": "mio_step",
          "settings": {
            "title": "Recibe y paga",
            "text": "Pagas en efectivo cuando el pedido llega a tus manos.",
            "icon": "cash"
          }
        }
      },
      "block_order": [
        "s1",
        "s2",
        "s3"
      ]
    }
  ]
}
{% endschema %}
