{%- liquid
  assign has_deadline = false
  if section.settings.end_date != blank
    assign has_deadline = true
  endif
-%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>

<section
  class="mio-offer section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }} spacing-style"
  style="{% render 'spacing-style', settings: section.settings %}"
>
  <div class="mio-offer__panel" data-mio-reveal>
    <div class="mio-offer__copy">
      {%- if section.settings.eyebrow != blank -%}
        <p class="mio-offer__eyebrow">
          {% render 'mio-icons', icon: 'spark', size: 14 %}
          {{ section.settings.eyebrow }}
        </p>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h2 class="mio-offer__title">{{ section.settings.heading }}</h2>
      {%- endif -%}

      {%- if section.settings.text != blank -%}
        <div class="mio-offer__text rte">{{ section.settings.text }}</div>
      {%- endif -%}

      {%- if section.settings.code != blank -%}
        <p class="mio-offer__code">
          <span>Código:</span>
          <strong>{{ section.settings.code }}</strong>
        </p>
      {%- endif -%}
    </div>

    <div class="mio-offer__aside">
      {%- if has_deadline -%}
        <p class="mio-offer__deadline-label">La oferta termina en</p>
        <div
          class="mio-offer__countdown"
          data-mio-countdown="{{ section.settings.end_date }}"
          role="timer"
          aria-label="Tiempo restante de la oferta"
        >
          <div class="mio-offer__unit">
            <span data-mio-unit="days">00</span>
            <small>días</small>
          </div>
          <span class="mio-offer__colon" aria-hidden="true">:</span>
          <div class="mio-offer__unit">
            <span data-mio-unit="hours">00</span>
            <small>horas</small>
          </div>
          <span class="mio-offer__colon" aria-hidden="true">:</span>
          <div class="mio-offer__unit">
            <span data-mio-unit="minutes">00</span>
            <small>min</small>
          </div>
          <span class="mio-offer__colon" aria-hidden="true">:</span>
          <div class="mio-offer__unit">
            <span data-mio-unit="seconds">00</span>
            <small>seg</small>
          </div>
        </div>
      {%- endif -%}

      {%- if section.settings.button_label != blank -%}
        <a class="button mio-offer__button" href="{{ section.settings.button_link }}">
          {{ section.settings.button_label }}
        </a>
      {%- endif -%}

      {%- if section.settings.note != blank -%}
        <p class="mio-offer__note">{{ section.settings.note }}</p>
      {%- endif -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .mio-offer__panel {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
    padding: clamp(22px, 4vw, 44px);
    border-radius: 28px;
    background: var(--mio-yellow);
    color: var(--mio-ink);
    overflow: hidden;
    position: relative;
  }

  .mio-offer__panel::after {
    content: '';
    position: absolute;
    inset-block-start: -40%;
    inset-inline-end: -12%;
    width: 40%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.35);
    pointer-events: none;
  }

  .mio-offer__copy,
  .mio-offer__aside {
    position: relative;
    z-index: 1;
  }

  .mio-offer__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin: 0 0 12px;
    padding: 6px 11px;
    border-radius: 100px;
    background: rgb(16 16 20 / 0.08);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .mio-offer__title {
    margin: 0;
    font-size: clamp(1.75rem, 5vw, 3.25rem);
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--mio-ink);
  }

  .mio-offer__text {
    margin-block-start: 10px;
    max-width: 46ch;
    font-size: 0.9375rem;
    line-height: 1.5;
    color: rgb(16 16 20 / 0.72);
  }

  .mio-offer__text p {
    margin: 0;
  }

  .mio-offer__code {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin: 16px 0 0;
    padding: 8px 12px;
    border: 1.5px dashed rgb(16 16 20 / 0.35);
    border-radius: 10px;
    font-size: 0.8125rem;
  }

  .mio-offer__code strong {
    font-family: var(--font-heading--family);
    letter-spacing: 0.08em;
    font-size: 0.9375rem;
  }

  .mio-offer__aside {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 10px;
    justify-content: center;
  }

  .mio-offer__deadline-label {
    margin: 0;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    opacity: 0.65;
  }

  .mio-offer__countdown {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .mio-offer__unit {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    min-width: 58px;
    padding: 8px 6px;
    border-radius: 12px;
    background: var(--mio-ink);
    color: #fff;
  }

  .mio-offer__unit span {
    font-family: var(--font-heading--family);
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  .mio-offer__unit small {
    font-size: 0.625rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.62;
  }

  .mio-offer__colon {
    font-weight: 700;
    opacity: 0.4;
    transform: translateY(-6px);
  }

  .mio-offer__button {
    margin-block-start: 6px;
    min-height: 50px;
  }

  .mio-offer__note {
    margin: 0;
    font-size: 0.6875rem;
    opacity: 0.6;
  }

  .mio-offer__countdown[data-mio-countdown-finished] {
    opacity: 0.4;
  }

  @media screen and (min-width: 750px) {
    .mio-offer__panel {
      grid-template-columns: 1.35fr 0.9fr;
      align-items: center;
      gap: 32px;
    }

    .mio-offer__aside {
      align-items: flex-start;
    }

    .mio-offer__unit {
      min-width: 64px;
      padding: 10px 8px;
    }

    .mio-offer__unit span {
      font-size: 1.5rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Mio · Oferta",
  "class": "mio-offer-wrapper",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Antetítulo",
      "default": "Oferta por tiempo limitado"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Hasta 40% OFF solo hoy"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Texto",
      "default": "<p>Aprovecha antes de que se agoten. Envío contra entrega disponible en todo el país.</p>"
    },
    {
      "type": "text",
      "id": "code",
      "label": "Código de descuento",
      "default": "MIO10"
    },
    {
      "type": "text",
      "id": "end_date",
      "label": "Fecha de cierre",
      "info": "Formato AAAA-MM-DD. Déjalo vacío para ocultar el contador.",
      "default": "2026-12-31"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Botón",
      "default": "Aprovechar oferta"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Enlace del botón"
    },
    {
      "type": "text",
      "id": "note",
      "label": "Nota",
      "default": "Stock limitado · Aplica para pedidos contra entrega"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Esquema de color",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Ancho",
      "options": [
        { "value": "page-width", "label": "Página" },
        { "value": "full-width", "label": "Completo" }
      ],
      "default": "page-width"
    },
    {
      "type": "header",
      "content": "Espaciado"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Arriba",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Abajo",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 24
    }
  ],
  "presets": [
    {
      "name": "Mio · Oferta",
      "category": "Mio Store"
    }
  ]
}
{% endschema %}
