{%- if section.blocks.size > 0 -%}
  <div class="section-background color-{{ section.settings.color_scheme }}"></div>

  <section
    class="mio-trust section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }} spacing-style"
    style="{% render 'spacing-style', settings: section.settings %}"
  >
    <ul class="mio-trust__grid" role="list" data-mio-stagger="80">
      {%- for block in section.blocks -%}
        <li class="mio-trust__item" data-mio-reveal {{ block.shopify_attributes }}>
          <span class="mio-trust__icon" aria-hidden="true">
            {% render 'mio-icons', icon: block.settings.icon, size: 21 %}
          </span>
          <span class="mio-trust__copy">
            <strong>{{ block.settings.title }}</strong>
            {%- if block.settings.text != blank -%}
              <small>{{ block.settings.text }}</small>
            {%- endif -%}
          </span>
        </li>
      {%- endfor -%}
    </ul>
  </section>
{%- endif -%}

{% stylesheet %}
  .mio-trust {
    border-block: 1px solid rgb(var(--color-foreground-rgb) / 0.08);
  }

  .mio-trust__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px 14px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .mio-trust__item {
    display: flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
  }

  .mio-trust__icon {
    display: grid;
    place-items: center;
    flex: 0 0 auto;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--mio-yellow);
    color: var(--mio-ink);
  }

  .mio-trust__copy {
    display: flex;
    flex-direction: column;
    gap: 1px;
    min-width: 0;
  }

  .mio-trust__copy strong {
    font-size: 0.8125rem;
    font-weight: 600;
    line-height: 1.25;
    color: var(--color-foreground-heading);
  }

  .mio-trust__copy small {
    font-size: 0.6875rem;
    line-height: 1.3;
    color: rgb(var(--color-foreground-rgb) / 0.6);
  }

  @media screen and (min-width: 750px) {
    .mio-trust__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 24px;
    }
  }

  @media screen and (min-width: 990px) {
    .mio-trust__icon {
      width: 44px;
      height: 44px;
    }

    .mio-trust__copy strong {
      font-size: 0.875rem;
    }

    .mio-trust__copy small {
      font-size: 0.75rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Mio · Barra de confianza",
  "class": "mio-trust-wrapper",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Esquema de color",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Ancho",
      "options": [
        {
          "value": "page-width",
          "label": "Página"
        },
        {
          "value": "full-width",
          "label": "Completo"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Arriba",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 22
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Abajo",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 22
    }
  ],
  "blocks": [
    {
      "type": "mio_benefit",
      "name": "Beneficio",
      "limit": 4,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icono",
          "options": [
            {
              "value": "truck",
              "label": "Envío"
            },
            {
              "value": "cash",
              "label": "Contra entrega"
            },
            {
              "value": "shield",
              "label": "Garantía"
            },
            {
              "value": "return",
              "label": "Devoluciones"
            },
            {
              "value": "whatsapp",
              "label": "WhatsApp"
            },
            {
              "value": "card",
              "label": "Pagos"
            },
            {
              "value": "clock",
              "label": "Tiempo"
            }
          ],
          "default": "truck"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Título",
          "default": "Envío a todo Colombia"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Descripción",
          "default": "1 a 3 días hábiles"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Mio · Barra de confianza",
      "category": "Mio Store",
      "blocks": {
        "b1": {
          "type": "mio_benefit",
          "settings": {
            "icon": "cash",
            "title": "Pago contra entrega",
            "text": "Pagas al recibir"
          }
        },
        "b2": {
          "type": "mio_benefit",
          "settings": {
            "icon": "truck",
            "title": "Envío nacional",
            "text": "1 a 3 días hábiles"
          }
        },
        "b3": {
          "type": "mio_benefit",
          "settings": {
            "icon": "shield",
            "title": "Compra protegida",
            "text": "Garantía de 30 días"
          }
        },
        "b4": {
          "type": "mio_benefit",
          "settings": {
            "icon": "whatsapp",
            "title": "Soporte real",
            "text": "Respondemos en minutos"
          }
        }
      },
      "block_order": [
        "b1",
        "b2",
        "b3",
        "b4"
      ]
    }
  ]
}
{% endschema %}
